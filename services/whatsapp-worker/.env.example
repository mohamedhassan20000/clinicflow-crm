# ClinicFlow WhatsApp linked-device worker.
#
# Run exactly ONE instance per deployment. Two instances sharing this database
# would each try to hold the same clinic's session; the worker refuses a session
# another instance is still heart-beating, but a single instance is the
# supported topology.

# The TCP port to listen on. Railway (and most container platforms) inject this
# automatically — set it there only if yours does not. Locally, pick a port the
# Next.js dev server is not using.
PORT=8787
# Optional stable name for this instance; a random one is generated if unset.
WORKER_ID=

# Supabase project (the SAME project the application uses) and its service-role
# key. The worker writes session state, encrypted device identities and the
# clinic_channels row for a paired number.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The SAME base64 32-byte key the application uses for channel credentials.
# Device identities are sealed with it, so a mismatch makes every stored pairing
# unreadable and every clinic has to scan again.
#   openssl rand -base64 32
MESSAGING_CREDENTIALS_KEY=

# Shared secrets between the application and this worker. Both must be at least
# 32 characters and must match the application's values exactly.
#   openssl rand -base64 48
# The application presents this as a bearer token when it calls the worker:
WHATSAPP_WORKER_TOKEN=
# The worker signs its callbacks to the application with this:
WHATSAPP_WORKER_CALLBACK_SECRET=

# Where to deliver inbound WhatsApp traffic. Production: https://clinicflow.fit
CLINICFLOW_APP_URL=

# Local development only. `pnpm dev:https` serves a mkcert-issued certificate,
# which Node will not trust without its CA. Never set this in production.
#   NODE_EXTRA_CA_CERTS="$HOME/Library/Application Support/mkcert/rootCA.pem"

# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
