{
  // The suite lives outside the build: tsconfig.json emits dist/ from src/ and
  // must not carry test files into the image. This config type-checks the tests
  // against the same strict settings without emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
