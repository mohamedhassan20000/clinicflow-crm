# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin used in auth email links. Set in Vercel Production;
# leave unset locally and on previews so the request host is used instead.
NEXT_PUBLIC_SITE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend webhook signing secret (whsec_…) — used from P3B's webhook route
RESEND_WEBHOOK_SECRET=

# 360dialog hosted onboarding (server-only; must be HTTPS)
DIALOG360_SIGNUP_URL=

# Messaging (P3A) — AES-256-GCM key for per-clinic channel credentials at
# rest (clinic_channels.credentials_encrypted). Base64-encoded 32 bytes:
#   openssl rand -base64 32
# Rotating it requires re-encrypting stored channel credentials.
MESSAGING_CREDENTIALS_KEY=

# AI assistant (P4A configuration; model calls are wired in P4B). Plain
# provider/model strings route through Vercel AI Gateway. On Vercel, OIDC is
# automatic; for local development refresh VERCEL_OIDC_TOKEN with
# `vercel env pull .env.local`. AI_GATEWAY_API_KEY is the static-key fallback
# for CI or non-Vercel runtimes and should be unset when OIDC is available.
# Model overrides are optional; blank values use the defaults in lib/ai/client.ts.
AI_MODEL_DOCTOR=
AI_MODEL_PATIENT=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=

# Daily display-only FX snapshots (server-only)
OPEN_EXCHANGE_RATES_APP_ID=
CRON_SECRET=

# Sentry (optional in local dev)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
