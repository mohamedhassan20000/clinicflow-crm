# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# licensed font source — founder delivery artifact, must never enter git history (P2A-G1 / P2A-L1).
# Only the required Manrope PDF runtime face and five shipped Thmanyah Sans woff2 UI faces are
# re-included below; every other font artifact (OTF desktop faces, licence PDFs, the specimen guide,
# and the serif subfamilies) is excluded.
/Thmanyah-Font-Family/
*.otf
*.ttf
*.woff
*.woff2
!/app/fonts/manrope/*.woff2
!/app/fonts/thmanyah/*.woff2

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# `next dev --experimental-https` self-signed cert + local mkcert CA
/certificates/

# typescript
*.tsbuildinfo
next-env.d.ts

/.p2c-messages/

# local Supabase sync artifacts (DB backups + remote data export) — never commit
/.local-db-sync/

# services/ are separately deployed Node services with their own installs
/services/*/node_modules
/services/*/dist
