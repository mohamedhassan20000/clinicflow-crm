# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin used in auth email links. Set in Vercel Production;
# leave unset locally and on previews so the request host is used instead.
NEXT_PUBLIC_SITE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend webhook signing secret (whsec_…) — used from P3B's webhook route
RESEND_WEBHOOK_SECRET=

# 360dialog hosted onboarding (server-only; must be HTTPS)
DIALOG360_SIGNUP_URL=

# Meta Tech Provider / Embedded Signup (P6C)
# Public SDK identifiers:
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
# Server-only app and webhook credentials:
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Platform Business Manager/system-user assets used to validate the OAuth
# signup result, assign the WABA, register the selected phone, subscribe the
# app, and make subsequent Cloud API calls:
META_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
# Six digits; stored server-side only and sent to Meta's phone /register call.
META_PHONE_REGISTRATION_PIN=
# Optional; defaults to the adapter's certified Graph version.
META_GRAPH_API_VERSION=

# Messaging (P3A) — AES-256-GCM key for per-clinic channel credentials at
# rest (clinic_channels.credentials_encrypted). Base64-encoded 32 bytes:
#   openssl rand -base64 32
# Rotating it requires re-encrypting stored channel credentials.
MESSAGING_CREDENTIALS_KEY=

# AI assistant (P4.5A). Vercel deployments use OIDC for AI Gateway by default;
# use this server-only static key only when OIDC is unavailable (for example,
# local development). Overrides are optional and must match a certified model
# in lib/ai/platform/registry.ts; arbitrary provider/model ids fail closed.
AI_GATEWAY_API_KEY=
AI_MODEL_DOCTOR=
AI_MODEL_PATIENT=
# Local development only: opt out of Gateway zero-data-retention when the dev
# Gateway account has no ZDR provisioned. Ignored in production, where certified
# routes always enforce ZDR. Leave unset unless local managed/hybrid calls fail.
# AI_GATEWAY_ZDR=false
# Optional HMAC secret for pseudonymous Gateway user attribution. When unset,
# no clinic/user tracking identifier is sent externally.
AI_TRACKING_HMAC_KEY=
# Dedicated, versioned AES-256-GCM key ring for tenant AI credentials. Never
# reuse MESSAGING_CREDENTIALS_KEY. Generate each key with:
# openssl rand -base64 32
AI_CREDENTIALS_ACTIVE_KEY_VERSION=1
AI_CREDENTIALS_KEY_V1=

# Daily display-only FX snapshots (server-only)
OPEN_EXCHANGE_RATES_APP_ID=
CRON_SECRET=

# Sentry (optional in local dev)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
