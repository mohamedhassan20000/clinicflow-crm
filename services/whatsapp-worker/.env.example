# ClinicFlow WhatsApp linked-device worker.
#
# Run exactly ONE instance per deployment. Two instances sharing this database
# would each try to hold the same clinic's session; the worker refuses a session
# another instance is still heart-beating, but a single instance is the
# supported topology.

# The TCP port to listen on. Railway (and most container platforms) inject this
# automatically — set it there only if yours does not. Locally, pick a port the
# Next.js dev server is not using.
PORT=8787
# Optional stable name for this instance; a random one is generated if unset.
WORKER_ID=

# Supabase project (the SAME project the application uses) and its service-role
# key. The worker writes session state, encrypted device identities and the
# clinic_channels row for a paired number.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The SAME base64 32-byte key the application uses for channel credentials.
# Device identities are sealed with it, so a mismatch makes every stored pairing
# unreadable and every clinic has to scan again.
#   openssl rand -base64 32
MESSAGING_CREDENTIALS_KEY=

# Shared secrets between the application and this worker. Both must be at least
# 32 characters and must match the application's values exactly.
#   openssl rand -base64 48
# The application presents this as a bearer token when it calls the worker:
WHATSAPP_WORKER_TOKEN=
# The worker signs its callbacks to the application with this:
WHATSAPP_WORKER_CALLBACK_SECRET=

# Where to deliver inbound WhatsApp traffic. Production: https://clinicflow.fit
CLINICFLOW_APP_URL=

# Whether an outgoing one-to-one message may be addressed by LID (`<opaque>@lid`)
# when WhatsApp has asserted one for the recipient on this session. On unless set
# to 0/false/no/off.
#
# WhatsApp is migrating direct chats from phone-number addressing to LID
# addressing, and Baileys 6.7.24 keys Signal sessions on the JID's user part
# alone — so a LID-addressed chat and a phone-addressed one are two unrelated
# sessions with the same device. Replying over the address space the conversation
# is actually being held in is what keeps the two from diverging.
#
# A LID is only ever used when WhatsApp itself stated the pairing; it is never
# derived from a phone number. Set this to 0 to pin every send to the
# phone-number path if a LID-addressed send ever misbehaves.
WHATSAPP_OUTBOUND_LID_ROUTING=1

# Largest private storage object loaded for one outbound media send.
WHATSAPP_OUTBOUND_MEDIA_MAX_BYTES=10485760

# Local development only. `pnpm dev:https` serves a mkcert-issued certificate,
# which Node will not trust without its CA. Never set this in production.
#   NODE_EXTRA_CA_CERTS="$HOME/Library/Application Support/mkcert/rootCA.pem"

# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Development ownership takeover. OFF unless set, and never set on a deployed
# worker.
#
# A session may only be held by one worker at a time — two sockets on one linked
# device corrupt each other's Signal state and cost the clinic a rescan. That
# rule is not relaxed here. What this does is let a worker *ask* the current
# holder for a session: the holder finishes what it is doing, closes its socket,
# releases ownership, and this instance then wins it through the same fenced
# claim as any other adoption. Ownership returns the same way when you stop:
# shutting down releases the session and the deployed worker picks it back up on
# its next reconcile sweep (within ~60s).
#
# Requires an explicit WORKER_ID, which must differ from the deployed worker's.
# Two workers sharing one id defeats the ownership check entirely, and the worker
# refuses to boot if it finds its own id already live.
WHATSAPP_DEV_TAKEOVER=0
